<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="dev.brewkits.native_workmanager">

    <!-- Required on Android 13+ (API 33+) to show notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        The foreground-service permissions and the SystemForegroundService type override
        that isHeavyTask=true (ForegroundNativeWorker / KmpHeavyWorker) needs are
        intentionally NOT declared here.

        Fixes a Play Store rejection for apps that never use isHeavyTask: declaring those
        unconditionally in the plugin's own manifest merged them into every consumer app's
        final APK regardless of whether that app ever calls ForegroundNativeWorker —
        Google Play flags apps carrying foreground-service permissions they never
        exercise. Mirrors the same fix kmpworkmanager v3.2.0 made to its own manifest for
        the identical reason (upstream issue #64). Enforced by ManifestGuardTest so this
        can't silently regress.

        If your app DOES use isHeavyTask=true, add the required permissions and service
        type override to YOUR OWN AndroidManifest.xml — see the "Android 14+ Foreground
        Services" section of doc/ANDROID_SETUP.md for the exact snippet, or
        example/android/app/src/main/AndroidManifest.xml for a working reference.

        Without them, ForegroundNativeWorker's setForeground() call throws
        SecurityException on Android 14+ (already caught and logged, not fatal — see
        ForegroundNativeWorker.kt's doWork(), which falls back to running as regular
        background work).
    -->

    <application>
        <!-- BroadcastReceiver for the Cancel button in download progress notifications. -->
        <receiver
            android:name="dev.brewkits.native_workmanager.notification.NotificationCancelReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.brewkits.native_workmanager.CANCEL_DOWNLOAD" />
            </intent-filter>
        </receiver>

        <!-- BroadcastReceiver for the Pause button in download progress notifications. -->
        <receiver
            android:name="dev.brewkits.native_workmanager.notification.NotificationPauseReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.brewkits.native_workmanager.PAUSE_DOWNLOAD" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for openFile support (ACTION_VIEW with content:// URIs). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.native_workmanager.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/native_workmanager_file_paths" />
        </provider>

        <!--
            androidx.startup auto-init for native_workmanager.

            Merges into the host app's InitializationProvider to:
              1. Remove the default WorkManagerInitializer (we initialize WorkManager ourselves).
              2. Register NativeWorkManagerInitializer so it runs before Application.onCreate(),
                 restoring callbackHandle and initializing KmpWorkManager before any pending
                 DartWorker task fires after a process kill.

            Opt-out: Add <meta-data android:name="native_workmanager.auto_init"
                                    android:value="false" /> to your <application> block,
            then follow the manual setup guide in doc/ANDROID_SETUP.md.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">

            <!-- Remove WorkManager's default initializer — NativeWorkManagerInitializer
                 handles WorkManager initialization with our custom worker factory. -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />

            <!-- Register our initializer. -->
            <meta-data
                android:name="dev.brewkits.native_workmanager.NativeWorkManagerInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
