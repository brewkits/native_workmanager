<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only: device regression tests talk to a local server through
         `adb reverse` (scripts/android-cancellation-check.sh). Never in release. -->
    <application android:usesCleartextTraffic="true" tools:targetApi="m"/>
</manifest>
